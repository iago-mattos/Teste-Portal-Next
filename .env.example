# Copie este arquivo para .env.<perfil>.local, por exemplo .env.esteira.local.
# O arquivo .env.local deve conter somente: PW_PROFILE=<perfil>
# PORTAL_ENV permanece apenas para compatibilidade com os fallbacks Cypress antigos.
PORTAL_ENV=dev
PORTAL_URL=https://minhaproposta-dev.exemplo.com.br
PORTAL_ACCESS_URL=
PORTAL_ADMIN_URL=https://minhaproposta-dev.exemplo.com.br/admin
PORTAL_ADMIN_USER=usuario-admin-de-teste
PORTAL_ADMIN_PASSWORD=senha-admin-de-teste
PORTAL_TEST_CPF=00000000000
PORTAL_EXTERNAL_SIMULATION_URL=https://c6imobiliario.com.br
PORTAL_SIMULATOR_EMAIL=teste@exemplo.com.br
PORTAL_SIMULATOR_MOBILE=00000000000

# Contratos do ambiente usados ao publicar um novo lote criado pelo simulador.
# Confirme os textos na massa DEFAULT antes de executar pw:provision:publish.
PORTAL_MASS_DEFAULT_PHASE=Cadastro
PORTAL_MASS_DEFAULT_INTEREST_TYPE=

# Massas funcionais consumidas diretamente pelo Playwright. Em ambientes
# provisionados, estes valores ficam no overlay .env.<perfil>.masses.local;
# consulte .env.masses.example. Permanecem aqui como alternativa manual.
# Proposta principal: deve estar visivel, em Cadastro e com formulario acessivel.
PORTAL_PROPOSAL_DEFAULT=000000000
# Proposta cancelada no SCCI: deve aparecer cancelada e sem acao de completar cadastro.
PORTAL_PROPOSAL_CANCELED=000000000
# Proposta reprovada pela mesa: deve exibir Credito Reprovado e mensagem de contato.
PORTAL_PROPOSAL_CREDIT_REJECTED=000000000
# Proposta aprovada/avancada para Credito: deve exibir fase Credito e aguardar contato.
PORTAL_PROPOSAL_CREDIT_APPROVED=000000000
# Proposta expirada ha no maximo 30 dias: deve continuar visivel, sem permitir edicao.
PORTAL_PROPOSAL_EXPIRED=000000000
# Proposta expirada ha mais de 30 dias: nao pode aparecer na lista do Portal.
PORTAL_PROPOSAL_EXPIRED_OVER_30_DAYS=000000000
# Proposta ainda na jornada de Cadastro, usada para validar a navegacao da timeline.
PORTAL_PROPOSAL_TIMELINE_CADASTRO=000000000
# Proposta parada em Documentos, usada para validar a segunda jornada da timeline.
PORTAL_PROPOSAL_TIMELINE_DOCUMENTS=000000000
# Contrato visual da proposta padrao.
PORTAL_EXPECTED_PROPONENT_NAME=
PORTAL_EXPECTED_CPF_ENDING=
# A data limite e calculada pela suite como data de cadastro + 30 dias.
PORTAL_EXPECTED_REGISTRATION_DATE=
PORTAL_EXPECTED_PROPERTY_VALUE=
PORTAL_EXPECTED_FINANCED_VALUE=
PORTAL_EXPECTED_TERM=
PORTAL_EXPECTED_CURRENT_PHASE=
PORTAL_EXPECTED_INTEREST_TYPE=

# SCCI / AEJS.
AEJS_URL=https://desenv.exemplo.com.br/aejs/
AEJS_USERNAME=
AEJS_PASSWORD=
# true para o login C6 que exige "Acesso via Plataforma"; false para acesso direto.
# Quando AEJS_PATH estiver preenchido, a suite sempre usa acesso direto.
AEJS_USE_PLATFORM_ACCESS=true
AEJS_PATH=

# Operacoes oficiais de integracao Playwright.
# PJ com conjuge e garantidor PJ. A preparacao confirma a proposta e consome a massa.
PORTAL_INTEGRATION_PJ_OPERATION=000000000
# PF com terceiro na renda e garantidor PF. A preparacao confirma e consome a massa.
PORTAL_INTEGRATION_PF_OPERATION=000000000
# Imovel proprio quitado, sem garantidor. A preparacao confirma e consome a massa.
PORTAL_INTEGRATION_PAID_OFF_OPERATION=000000000
# Workflow documental. Os codigos, titulos e status esperados ficam logo abaixo.
PORTAL_INTEGRATION_WORKFLOW_OPERATION=000000000
# Massa exclusiva para enviar documentos no Portal e conferir os PDFs no SCCI.
PORTAL_INTEGRATION_DOCUMENT_PERSISTENCE_OPERATION=000000000
# Massa reutilizavel para rejeitar arquivos de 25/50 MB; deve permanecer em Documentos.
PORTAL_INTEGRATION_DOCUMENT_SIZE_OPERATION=000000000

# Dominios usados durante a preparacao Portal -> SCCI. Ajuste quando o perfil
# expuser rotulos diferentes para a mesma regra funcional.
PORTAL_INTEGRATION_PROFESSIONAL_ACTIVITY=ASSALARIADO
PORTAL_INTEGRATION_HOUSE_USE=Casa
PORTAL_INTEGRATION_APARTMENT_USE=Apartamento

# Contrato de andamento do workflow no SCCI/AEJS para este ambiente.
AEJS_WORKFLOW_REGISTRATION_TASK_CODE=997
AEJS_WORKFLOW_REGISTRATION_TASK_TITLE=Preencher dados cadastrais (Portal)
AEJS_WORKFLOW_REGISTRATION_TASK_STATUS=Finalizada
AEJS_WORKFLOW_DOCUMENTS_TASK_CODE=998
AEJS_WORKFLOW_DOCUMENTS_TASK_TITLE=Anexar documentação (Portal)
AEJS_WORKFLOW_DOCUMENTS_TASK_STATUS=Finalizada
AEJS_WORKFLOW_VALIDATION_TASK_CODE=996
AEJS_WORKFLOW_VALIDATION_TASK_TITLE=Validação do cadastro
AEJS_WORKFLOW_VALIDATION_TASK_STATUS=Disponível

# Protecoes de execucao.
ALLOW_TEST_MUTATION=false
ALLOW_REACT_418_QUARANTINE=false
