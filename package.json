{
  "name": "portalnext",
  "version": "1.0.0",
  "description": "Suite E2E principal do PortalNext com Playwright e TypeScript",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "npm run cy:run:smoke",
    "cy:run:smoke": "cypress run --spec \"cypress/e2e/00-auth-smoke.cy.ts,cypress/e2e/00-open-proposal-smoke.cy.ts\"",
    "cy:run:functional": "cypress run --spec \"cypress/e2e/cliente/**/*.cy.ts\"",
    "cy:run:integration": "node scripts/require-mutation-opt-in.mjs --require-operation && cypress run --spec \"cypress/e2e/integracoes/14-preparar-integracao.cy.ts,cypress/e2e/integracoes/16-verificar-aejs.cy.ts\"",
    "cy:run:transitions": "node scripts/require-mutation-opt-in.mjs && cypress run --spec \"cypress/e2e/integracoes/15-finalizar-cancelar-integracao.cy.ts\"",
    "cy:run:report": "npm run cy:run && npm run report:mochawesome",
    "report:merge": "mochawesome-merge \"cypress/results/*.json\" -o cypress/results/mochawesome.json",
    "report:generate": "marge cypress/results/mochawesome.json --reportDir cypress/results --reportFilename mochawesome-report",
    "report:mochawesome": "npm run report:merge && npm run report:generate",
    "config:check": "node scripts/check-environment-config.mjs all",
    "config:check:portal": "node scripts/check-environment-config.mjs portal",
    "config:check:core": "node scripts/check-core-config.mjs",
    "pw:test": "npm run config:check && playwright test",
    "pw:test:safe": "npm run config:check:portal && playwright test --project=smoke --project=functional-readonly",
    "pw:test:all": "npm run config:check && node scripts/require-mutation-opt-in.mjs && node scripts/run-playwright-all.mjs",
    "pw:test:smoke": "npm run config:check:portal && playwright test --project=smoke",
    "pw:test:functional": "npm run config:check:portal && node scripts/require-mutation-opt-in.mjs && playwright test --project=functional-readonly --project=functional-mutation",
    "pw:test:functional:readonly": "npm run config:check:portal && playwright test --project=functional-readonly",
    "pw:test:functional:mutation": "npm run config:check:portal && node scripts/require-mutation-opt-in.mjs && playwright test --project=functional-mutation",
    "pw:test:core": "npm run config:check:core && node scripts/require-mutation-opt-in.mjs && playwright test --project=core --project=core-mobile",
    "pw:test:core:consumable-documents": "npm run config:check:core && node scripts/require-core-capability.mjs consumable-document-pair && node scripts/require-mutation-opt-in.mjs && PW_INCLUDE_CONSUMABLE=true playwright test tests/core/consumable/document-batch.spec.ts --project=core --workers=1 --grep @consumable",
    "pw:test:integration": "npm run config:check && node scripts/require-mutation-opt-in.mjs && playwright test --project=integration --project=simulator-integration",
    "pw:test:integration:readonly": "npm run config:check && playwright test --project=integration --grep @readonly",
    "pw:test:integration:mutation": "npm run config:check && node scripts/require-mutation-opt-in.mjs && playwright test --project=integration --project=simulator-integration --grep @mutation",
    "pw:provision:pilot": "node scripts/require-mutation-opt-in.mjs && node scripts/run-provisioning-slot.mjs CANCELED",
    "pw:provision:create": "node scripts/require-mutation-opt-in.mjs && node scripts/run-provisioning-slot.mjs",
    "pw:provision:create-batch": "node scripts/require-mutation-opt-in.mjs && node scripts/run-provisioning-batch.mjs",
    "pw:provision:status": "node scripts/manage-provisioning-registry.mjs status",
    "pw:provision:mark-ready": "node scripts/manage-provisioning-registry.mjs mark-ready",
    "pw:provision:register-manual": "node scripts/manage-provisioning-registry.mjs register-manual",
    "pw:provision:publish": "node scripts/manage-provisioning-registry.mjs publish",
    "pw:provision:c6:create": "node scripts/require-mutation-opt-in.mjs && node scripts/run-c6-provisioning-slot.mjs",
    "pw:provision:c6:create-batch": "node scripts/require-mutation-opt-in.mjs && node scripts/run-c6-provisioning-batch.mjs",
    "pw:provision:c6:prepare-phase": "node scripts/require-mutation-opt-in.mjs && node scripts/run-c6-phase-preparation.mjs",
    "pw:provision:c6:prepare-phases": "node scripts/require-mutation-opt-in.mjs && node scripts/run-c6-phase-preparation-batch.mjs",
    "pw:provision:c6:status": "node scripts/manage-c6-provisioning-registry.mjs status",
    "pw:provision:c6:mark-ready": "node scripts/manage-c6-provisioning-registry.mjs mark-ready",
    "pw:provision:c6:register-manual": "node scripts/manage-c6-provisioning-registry.mjs register-manual",
    "pw:provision:c6:publish": "node scripts/manage-c6-provisioning-registry.mjs publish",
    "pw:provision:core-masses": "node scripts/require-mutation-opt-in.mjs && playwright test --config=playwright.provision.config.ts --project=core-mass-provisioning",
    "pw:test:list": "playwright test --list",
    "pw:check": "playwright test --list --pass-with-no-tests",
    "pw:ui": "npm run config:check && playwright test --ui",
    "pw:report": "playwright show-report",
    "pw:report:portal": "npm run pw:report:portal:build && npm run pw:report:portal:open",
    "pw:report:portal:build": "node scripts/build-portal-report.mjs",
    "pw:report:portal:open": "vite preview --config report-ui/vite.config.ts --open",
    "pw:report:package": "node scripts/pack-playwright-report.mjs",
    "pw:test:report:sample": "PW_EVIDENCE=all playwright test tests/smoke --project=smoke --workers=1 && npm run pw:report:portal:build",
    "pw:install": "playwright install chromium",
    "demo:simulador": "node scripts/require-mutation-opt-in.mjs && node scripts/run-demo-simulator.mjs",
    "demo:simulador:mp4": "node scripts/convert-demo-video.mjs",
    "typecheck": "tsc --noEmit && tsc -p report-ui/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:test-contracts": "node scripts/check-test-contracts.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:test-contracts && npm run pw:check",
    "test": "npm run check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  }
}
