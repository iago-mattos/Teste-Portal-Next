{
  "name": "portalnext",
  "version": "1.0.0",
  "description": "Testes automatizados do PortalNext com Cypress, Playwright e TypeScript",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "npm run cy:run:smoke",
    "cy:run:smoke": "cypress run --spec \"cypress/e2e/00-auth-smoke.cy.ts,cypress/e2e/00-open-proposal-smoke.cy.ts\"",
    "cy:run:functional": "cypress run --spec \"cypress/e2e/cliente/**/*.cy.ts\"",
    "cy:run:integration": "node scripts/require-mutation-opt-in.mjs --require-operation && cypress run --spec \"cypress/e2e/integracoes/14-preparar-integracao.cy.ts,cypress/e2e/integracoes/16-verificar-aejs.cy.ts\"",
    "cy:run:transitions": "node scripts/require-mutation-opt-in.mjs && cypress run --spec \"cypress/e2e/integracoes/15-finalizar-cancelar-integracao.cy.ts\"",
    "cy:run:report": "npm run cy:run && npm run report:mochawesome",
    "report:merge": "mochawesome-merge \"cypress/results/*.json\" -o cypress/results/mochawesome.json",
    "report:generate": "marge cypress/results/mochawesome.json --reportDir cypress/results --reportFilename mochawesome-report",
    "report:mochawesome": "npm run report:merge && npm run report:generate",
    "pw:test": "playwright test",
    "pw:test:safe": "playwright test --project=smoke --project=functional-readonly",
    "pw:test:all": "node scripts/require-mutation-opt-in.mjs && playwright test",
    "pw:test:smoke": "playwright test --project=smoke",
    "pw:test:functional": "node scripts/require-mutation-opt-in.mjs && playwright test --project=functional-readonly --project=functional-mutation",
    "pw:test:functional:readonly": "playwright test --project=functional-readonly",
    "pw:test:functional:mutation": "node scripts/require-mutation-opt-in.mjs && playwright test --project=functional-mutation",
    "pw:test:integration": "node scripts/require-mutation-opt-in.mjs && playwright test --project=integration",
    "pw:test:integration:readonly": "playwright test --project=integration --grep @readonly",
    "pw:test:integration:mutation": "node scripts/require-mutation-opt-in.mjs && playwright test --project=integration --grep @mutation",
    "pw:test:list": "playwright test --list",
    "pw:check": "playwright test --list --pass-with-no-tests",
    "pw:ui": "playwright test --ui",
    "pw:report": "playwright show-report",
    "pw:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:test-contracts": "node scripts/check-test-contracts.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:test-contracts && npm run pw:check",
    "test": "npm run check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.61.1",
    "@types/node": "^25.9.2",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
