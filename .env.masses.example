# Este arquivo representa o overlay gerado em .env.<perfil>.masses.local.
# URLs, credenciais, flags e workflow pertencem a .env.<perfil>.local.
# O provisionador só publica PORTAL_MASS_BATCH_STATUS=ready quando todos os
# slots oficiais possuem operação e tiveram seu estado funcional confirmado.
PORTAL_MASS_BATCH_STATUS=pending
# Quantidade de propostas que o provisionador deve criar neste lote (1 a 15).
PORTAL_MASS_TARGET_COUNT=15

# CPF associado às propostas do lote.
PORTAL_TEST_CPF=00000000000
# Mapa gerado que preserva o vínculo entre cada operação e seu CPF sintético.
PORTAL_MASS_OPERATION_CPFS_JSON={}

# Massas funcionais.
PORTAL_PROPOSAL_CANCELED=000000000
PORTAL_PROPOSAL_DEFAULT=000000000
PORTAL_PROPOSAL_EXPIRED=000000000
PORTAL_PROPOSAL_CREDIT_REJECTED=000000000
PORTAL_PROPOSAL_CREDIT_APPROVED=000000000
PORTAL_PROPOSAL_EXPIRED_OVER_30_DAYS=000000000
PORTAL_PROPOSAL_TIMELINE_CADASTRO=000000000
PORTAL_PROPOSAL_TIMELINE_DOCUMENTS=000000000

# Massas de integração.
PORTAL_INTEGRATION_PJ_OPERATION=000000000
PORTAL_INTEGRATION_PF_OPERATION=000000000
PORTAL_INTEGRATION_PAID_OFF_OPERATION=000000000
PORTAL_INTEGRATION_WORKFLOW_OPERATION=000000000
PORTAL_INTEGRATION_DOCUMENT_PERSISTENCE_OPERATION=000000000
PORTAL_INTEGRATION_DOCUMENT_SIZE_OPERATION=000000000

# Contrato visual da massa DEFAULT.
PORTAL_EXPECTED_PROPONENT_NAME="Playwright BASE"
PORTAL_EXPECTED_CPF_ENDING=00
PORTAL_EXPECTED_REGISTRATION_DATE=DD/MM/AAAA
PORTAL_EXPECTED_PROPERTY_VALUE="R$ 1.500.000,00"
PORTAL_EXPECTED_FINANCED_VALUE="R$ 500.000,00"
PORTAL_EXPECTED_TERM="120 meses"
PORTAL_EXPECTED_CURRENT_PHASE=Cadastro
PORTAL_EXPECTED_INTEREST_TYPE=
